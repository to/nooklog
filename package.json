{
	"name": "nooklog",
	"version": "1.0.0",
	"description": "Local-first bookmark & search system",
	"type": "module",
	"main": "server/server.js",
	"scripts": {
		"start": "node server/server.js",
		"dev": "node --watch server/server.js",
		"dev:browser": "pm2 stop nooklog & concurrently \"npm run dev\" \"npx browser-sync start --proxy localhost:5050 --port 4000 --files public/**/*\"",
		"pm2:start": "pm2 delete nooklog 2>nul & pm2 start ecosystem.config.cjs",
		"pm2:stop": "pm2 stop nooklog",
		"pm2:restart": "pm2 stop nooklog & pm2 start ecosystem.config.cjs",
		"pm2:logs": "pm2 logs nooklog",
		"pm2:monit": "pm2 monit",
		"electron": "electron electron/main.cjs",
		"build": "npm rebuild && electron-builder -w",
		"test": "node --experimental-test-module-mocks --test-concurrency=1 --test test/**/*.test.js"
	},
	"build": {
		"appId": "com.nooklog.app",
		"productName": "Nooklog",
		"files": [
			"**/*",
			"!**/*.db",
			"!.git",
			"!work",
			"!logs",
			"!node_modules/**/.bin",
			"node_modules/**/*",
			"electron/**/*",
			"!data",
			"!work"
		],
		"asar": false,
		"win": {
			"target": "nsis",
			"icon": "electron/icon_256.png"
		}
	},
	"dependencies": {
		"@huggingface/transformers": "^3.8.1",
		"@libsql/client": "^0.17.0",
		"@mozilla/readability": "^0.5.0",
		"@orpc/openapi": "^1.13.9",
		"@orpc/server": "^1.13.9",
		"@orpc/zod": "^1.13.9",
		"ai": "^6.0.23",
		"archiver": "^7.0.1",
		"cors": "^2.8.5",
		"dotenv": "^16.6.1",
		"express": "^4.21.2",
		"express-asset-file-cache-middleware": "^1.3.0",
		"express-basic-auth": "1.2.1",
		"express-rate-limit": "8.3.1",
		"jsdom": "^25.0.1",
		"linkedom": "^0.18.12",
		"multer": "^2.1.1",
		"node-llama-cpp": "^3.17.1",
		"normalize-url": "^9.0.0",
		"p-queue": "9.1.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-stringify": "^11.0.0",
		"turndown": "^7.2.0",
		"turndown-plugin-gfm": "^1.0.2",
		"unified": "^11.0.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/stylelint-plugin": "^2.1.3",
		"chroma-js": "^3.2.0",
		"concurrently": "^9.2.1",
		"electron": "^40.6.0",
		"electron-builder": "^26.8.1",
		"eslint": "^10.0.0",
		"globals": "^17.3.0",
		"sharp": "^0.34.5",
		"stylelint": "^16.12.0",
		"stylelint-config-recess-order": "^7.6.1",
		"stylelint-config-standard": "^36.0.1",
		"stylelint-order": "^7.0.1",
		"stylelint-value-no-unknown-custom-properties": "^6.1.1"
	}
}
