{
	"name": "nookmark",
	"version": "1.0.0",
	"description": "Local-first bookmark & search system",
	"type": "module",
	"main": "server/server.js",
	"scripts": {
		"start": "node server/server.js",
		"dev": "node --watch server/server.js",
		"dev:browser": "pm2 stop nookmark & concurrently \"pnpm dev\" \"npx browser-sync start --proxy localhost:3000 --port 4000 --files public/**/*\"",
		"pm2:start": "pm2 delete nookmark 2>nul & pm2 start ecosystem.config.cjs",
		"pm2:stop": "pm2 stop nookmark",
		"pm2:logs": "pm2 logs nookmark",
		"pm2:monit": "pm2 monit",
		"electron": "electron electron/main.cjs",
		"build": "pnpm rebuild && electron-builder -w"
	},
	"build": {
		"appId": "com.nookmark.app",
		"productName": "Nookmark",
		"files": [
			"**/*",
			"!**/*.db",
			"!.git",
			"!work",
			"!logs",
			"!node_modules/**/.bin",
			"node_modules/**/*",
			"electron/**/*",
			"!data",
			"!work"
		],
		"asar": false,
		"win": {
			"target": "nsis",
			"icon": "electron/icon_256.png"
		}
	},
	"dependencies": {
		"@lancedb/lancedb": "^0.23.0",
		"@mozilla/readability": "^0.5.0",
		"ai": "^6.0.23",
		"apache-arrow": "^17.0.0",
		"cors": "^2.8.5",
		"dotenv": "^16.6.1",
		"express": "^4.21.2",
		"jsdom": "^25.0.1",
		"turndown": "^7.2.0"
	},
	"devDependencies": {
		"@eslint/js": "*",
		"@stylistic/stylelint-plugin": "*",
		"concurrently": "*",
		"electron": "*",
		"electron-builder": "*",
		"eslint": "*",
		"globals": "*",
		"stylelint": "*",
		"stylelint-config-recess-order": "*",
		"stylelint-config-standard": "*",
		"stylelint-order": "*",
		"stylelint-value-no-unknown-custom-properties": "*"
	}
}
