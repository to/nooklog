{
	"manifest_version": 3,
	"name": "Nooklog",
	"version": "0.1",
	"description": "Nooklog Official Extension",
	"key": "",
	"permissions": [
		"tabs",
		"contextMenus",
		"scripting",
		"activeTab",
		"system.display",
		"storage"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"options_ui": {
		"page": "page/setting.html",
		"open_in_tab": true
	},
	"action": {
		"default_icon": {
			"16": "image/icon_32.png",
			"32": "image/icon_32.png"
		}
	},
	"icons": {
		"16": "image/icon_32.png",
		"32": "image/icon_32.png",
		"48": "image/icon_48.png",
		"128": "image/icon_128.png"
	},
	"commands": {
		"open-update-page": {
			"description": "Open update page"
		}
	},
	"web_accessible_resources": [
		{
			"resources": [
				"content/content.js",
				"content/frame.html",
				"content/frame.js",
				"content/bridge.js"
			],
			"matches": [
				"<all_urls>"
			]
		}
	]
}
