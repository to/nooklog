{
	"manifest_version": 3,
	"name": "Nookmark",
	"version": "0.1",
	"description": "Nookmark Official Extension",
	"key": "",
	"permissions": [
		"tabs",
		"contextMenus",
		"scripting",
		"activeTab",
		"system.display",
		"storage"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_icon": {
			"16": "images/icon_16.png",
			"32": "images/icon_32.png",
			"48": "images/icon_48.png",
			"128": "images/icon_128.png"
		}
	},
	"icons": {
		"16": "images/icon_16.png",
		"32": "images/icon_32.png",
		"48": "images/icon_48.png",
		"128": "images/icon_128.png"
	},
	"commands": {
		"open-update-page": {
			"description": "Open update page"
		}
	},
	"web_accessible_resources": [
		{
			"resources": [
				"public/*"
			],
			"matches": [
				"<all_urls>"
			]
		}
	]
}