# NOOKLOG Configuration Guide
#
# This file defines the environment variables for your Nooklog instance.
# To get started, copy this file to '.env' and edit the values below.

# -- Server & Storage --
# Port number the server will listen on (Default: 5050).
# PORT=5050

# Application password for Basic Authentication.
# If set, a login dialog will be displayed when accessing the web UI.
# This is highly recommended for security when exposing your server to the internet.
# NOOKLOG_PASSWORD=your-secret-password

# Absolute path for storing data (database, favicon cache).
# Default: './data' on Linux, '~/.nooklog/data' on other platforms.
# NOOKLOG_DATA_PATH=/path/to/your/data

# Enable Read-Only mode (browsing only).
# This mode is ideal for running a lightweight, low-resource server
# when you just want to securely browse your bookmarks while away from home.
# Note: Any non-empty value (even 'false') will enable this mode.
# NOOKLOG_READONLY=true

# -- Logging --
# Log output level: trace, debug, info, warn, error (Default: info).
# PINO_LOG_LEVEL=info

# Execution environment: production or development (Default: development).
# - 'production': Outputs raw JSONL for log management tools.
# - 'development': Outputs human-readable "pretty" logs to the console.
# NODE_ENV=development

# -- Vector Search --
# Endpoint URL for OpenAI-compatible embedding service (e.g. OpenAI, DeepSeek, etc.)
# If you are using local Ollama (default), you can leave this empty.
# NOOKLOG_VECTOR_URL=http://localhost:11434/v1/embeddings
#
# API Key for the embedding service.
# NOOKLOG_VECTOR_API_KEY=your-api-key
#
# Note: Nooklog also checks standard 'OPENAI_BASE_URL' and 'OPENAI_API_KEY'
# environment variables as fallbacks! ✨

# -- Turso Database (Cloud Sync) --
# Turso is a distributed database that allows you to sync and share bookmarks
# across different environments (e.g., home and office).
# Get your details from the Turso dashboard: https://turso.tech/
# TURSO_DATABASE_URL=libsql://your-db-name-user.turso.io
# TURSO_AUTH_TOKEN=your-auth-token
#
# Tip: If you encounter 404 errors on some platforms (like Fly.io), try
# removing the regional prefix (e.g., 'aws-ap-northeast-1') from the URL
# and use the direct 'turso.io' domain instead.

# Enable "Embedded Replica" mode (sync local cache with cloud).
# With this enabled, you enjoy cloud benefits while maintaining local-level
# performance and offline support! ✨
# TURSO_REPLICA=true
#
# IMPORTANT: When enabling this for the first time, your local database file
# (nooklog.db) must NOT exist. If an existing local file is found that is
# not a valid replica, the application will fail to start.
