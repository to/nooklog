{
	"manifest_version": 3,
	"name": "Nooklog",
	"version": "0.6.3",
	"description": "Nooklog: Save pages to your self-hosted bookmarking system instantly.",
	"key": "",
	"permissions": [
		"tabs",
		"contextMenus",
		"scripting",
		"activeTab",
		"system.display",
		"storage",
		"sidePanel"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"side_panel": {
		"default_path": "content/frame.html"
	},
	"options_ui": {
		"page": "page/setting.html",
		"open_in_tab": true
	},
	"action": {
		"default_icon": {
			"16": "image/icon_32.png",
			"32": "image/icon_32.png"
		}
	},
	"icons": {
		"16": "image/icon_32.png",
		"32": "image/icon_32.png",
		"48": "image/icon_48.png",
		"128": "image/icon_128.png"
	},
	"commands": {
		"open-update-frame": {
			"suggested_key": {
				"default": "Ctrl+Shift+E",
				"mac": "Command+Shift+E"
			},
			"description": "Embed edit frame"
		},
		"open-update-panel": {
			"description": "Open edit side panel"
		},
		"open-update-window": {
			"description": "Open edit window"
		},
		"quick-save": {
			"description": "Quick Save this page"
		}
	},
	"web_accessible_resources": [
		{
			"resources": [
				"content/captureSelection.js",
				"content/embedUpdateFrame.js",
				"content/frame.html",
				"content/frame.js",
				"content/bridge.js"
			],
			"matches": [
				"<all_urls>"
			]
		}
	]
}